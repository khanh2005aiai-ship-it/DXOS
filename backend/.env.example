NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SWAGGER_ENABLED=true

# Required in development and production. Do not commit real credentials.
DATABASE_URL=mysql://dxos:change-me@localhost:3306/dx_os

# Required outside tests. Generate a unique non-default secret for every environment, for example:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-before-enabling-authentication
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Required in production. All backend replicas must use the same Redis instance
# or cluster so login/refresh rate-limit counters are shared. Development/test
# fall back to bounded process-local state when this is omitted.
# REDIS_URL=redis://localhost:6379

# Local/demo seed settings. DEMO_ADMIN_PASSWORD is required by the seed command
# and must never be committed or logged.
# DEMO_ADMIN_EMAIL=admin.demo@dxos.local
# DEMO_ADMIN_PASSWORD=generate-a-local-password-of-at-least-16-characters
# seed:demo reuses this password for NEW demo members only; existing passwords are preserved.
# seed:demo requires the existing dxos-demo admin and only accepts local development/test MySQL.

# Application-level auth protection. Production defaults are login 10/60s and refresh 30/60s;
# development and test defaults are wider. Edge/API-gateway throttling remains recommended.
# RATE_LIMIT_LOGIN_LIMIT=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# RATE_LIMIT_REFRESH_LIMIT=30
# RATE_LIMIT_REFRESH_WINDOW_SECONDS=60

# Optional absolute private directory, outside public/static hosting.
# Defaults to ~/.dx-os/files; backend process requires exclusive write access.
# FILE_STORAGE_ROOT=C:/dx-os-private/files

# AI boundary; production defaults to disabled. Mock is offline and needs no key.
# AI_PROVIDER=mock
# AI_MODEL=mock-v1
# AI_TIMEOUT_MS=5000
# To use the official OpenAI Chat Completions API locally, set all of these in a
# private, ignored .env file. Never commit or log the key.
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=replace-with-a-local-secret

# OIDC/Keycloak: disabled until configured; never copy a client secret into frontend.
SSO_ENABLED=false
# SSO_ISSUER=http://localhost:8180/realms/dxos
# SSO_CLIENT_ID=dxos-web
# SSO_REDIRECT_URI=http://localhost:5173/auth/sso/callback
# SSO_CLIENT_SECRET=private-confidential-client-secret-if-used

# ClamAV: enabled stack rejects uploads on infection, timeout or scanner failure.
FILE_SCAN_ENABLED=false
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=10000

# Optional Vault KV-v2 bootstrap. Token is read from a private file, never logged.
# VAULT_ENABLED=true
# VAULT_ADDR=https://vault.example.internal:8200
# VAULT_TOKEN_FILE=/run/secrets/vault_token
# VAULT_SECRET_PATH=secret/data/dxos
